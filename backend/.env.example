# MongoDB Configuration
MONGO_URI=
MONGOOSE_DEBUG=false

# Razorpay Configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Email Configuration (Gmail SMTP) ──────────────────────────────
# To enable email sending with Gmail:
#   1. Enable 2-Step Verification on your Google account
#      → https://myaccount.google.com/security
#   2. Generate an App Password:
#      → https://myaccount.google.com/apppasswords
#      → Select "Mail" → "Other (Custom name)" → Enter "Discovery ADCET"
#   3. Copy the 16-character password below (spaces are optional)
#   4. Set EMAIL_ENABLED=true
#
# ⚠️ Gmail daily limit: 500 emails/day (regular) or 2000/day (Workspace)
# ─────────────────────────────────────────────────────────────────────
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM=youraccount@gmail.com

# Admin Configuration
ADMIN_PASSWORD=

# Server Configuration
PORT=3000
NODE_ENV=development
